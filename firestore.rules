rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['predictionId', 'fixtureHome', 'fixtureAway', 'predictedOutcome', 'actualOutcome', 'accuracyRating', 'timestamp', 'userId'])
        && data.keys().size() == 8
        && data.predictionId is string && data.predictionId.size() <= 128
        && data.fixtureHome is string && data.fixtureHome.size() <= 100
        && data.fixtureAway is string && data.fixtureAway.size() <= 100
        && data.predictedOutcome in ['home', 'draw', 'away']
        && data.actualOutcome in ['home', 'draw', 'away']
        && data.accuracyRating is int && data.accuracyRating >= 1 && data.accuracyRating <= 5
        && data.timestamp == request.time
        && data.userId == request.auth.uid;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Feedback collection
    match /prediction_feedback/{feedbackId} {
      allow create: if isSignedIn() && isValidFeedback(request.resource.data);
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // No updates or deletes for audit integrity
      allow update, delete: if false;
    }

    // Shared Predictions
    match /shared_predictions/{shareId} {
      allow read: if true; // Publicly shareable
      allow create: if isSignedIn() 
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
